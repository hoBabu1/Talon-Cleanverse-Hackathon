# Free — create at https://cloud.reown.com. Needed for the WalletConnect/mobile
# QR wallet-connect flow (mobile-compatible UI is a stated requirement). Desktop
# injected wallets (MetaMask extension) work without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Public (anon-key) Supabase client for the browser — RLS-enforced, safe to expose.
# Fill in once a Supabase project exists.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
