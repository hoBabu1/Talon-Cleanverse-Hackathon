CLEANVERSE_SANDBOX_API_ID=your_api_id_here
CLEANVERSE_SANDBOX_API_KEY=your_base64_api_key_here
CLEANVERSE_BASE_URL=https://uatapi.cleanverse.com/api/cooperate

MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz

SUPABASE_URL=
SUPABASE_SERVICE_KEY=

PORT=4000

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# Optional guard on POST /identity/status (freeze / reinstate an A-Pass).
# Unset = the route is open (fine locally). Set it on a public deployment and
# mirror the value into the frontend's NEXT_PUBLIC_ADMIN_TOKEN.
ADMIN_TOKEN=
